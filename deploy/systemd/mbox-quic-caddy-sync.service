[Unit]
Description=MBox QUIC sync Caddy-managed domain TLS (explicit operator opt-in)
After=caddy.service
Wants=caddy.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/mbox/quic-caddy/sync.env
ExecStart=/usr/local/libexec/mbox-quic-caddy-sync --sync
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
