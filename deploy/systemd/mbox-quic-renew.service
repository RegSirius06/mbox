[Unit]
Description=Renew MBox QUIC leaf TLS certificate (operator opt-in)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/mbox/quic/renew.env
ExecStart=/usr/local/libexec/mbox-quic-cert-renew
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
